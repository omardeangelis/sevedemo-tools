# --- Credenziali obbligatorie ---
APIFY_TOKEN=
ANTHROPIC_API_KEY=

# --- Cookie LinkedIn (OPZIONALE) ---
# Lascialo VUOTO per usare solo le strategie no-cookie (consigliato).
# Se valorizzato, abilita le strategie autenticate (influencer-followers, job-posters-annunci)
# con cap conservativo (COOKIE_MAX_PROFILES). Usa SOLO un account dedicato/sacrificabile: rischio ban.
LINKEDIN_LI_AT=

# --- Modelli Claude (override opzionali) ---
SCORING_MODEL=claude-haiku-4-5-20251001
EMAIL_MODEL=claude-sonnet-4-6

# --- Parametri pipeline (override opzionali) ---
POOL_SIZE=200
ENRICH_CAP=120
TARGET_FREELANCE=20
TARGET_AZIENDA=20
FRESHNESS_DAYS=90
COOKIE_MAX_PROFILES=100
SCORING_CONCURRENCY=6
MIN_FIT_SCORE=50

# --- Fonte primaria influencer-post-respondents (override opzionali) ---
# Strategia primaria del run giornaliero: budget dominante + eseguita per prima.
PRIMARY_STRATEGY_ID=influencer-post-respondents
# Quota di POOL_SIZE riservata (cap, non forzata) alla primaria. 0.5 = ~50%.
PRIMARY_WEIGHT=0.5
# Quanti post per influencer scaricare (apimaestro total_posts).
POSTS_PER_INFLUENCER=5
# Quanti commenti per post scaricare (apimaestro limit, 1-100).
COMMENTS_PER_POST=100
# Finestra di freschezza dei post (giorni): i post più vecchi sono ignorati.
POST_RECENCY_DAYS=90
# Ruoli decisionali per l'espansione-azienda (CSV).
COMPANY_EXPANSION_ROLES=CEO,CTO,Founder,Co-founder,Head of Engineering,HR,Talent
# Cap di candidati per singola azienda espansa.
COMPANY_EXPANSION_PER_COMPANY=3
# Emette i candidati "tagged-person" (persone taggate nei post). Default false:
# la risolvibilità dell'URN sull'enrichment daily (dev_fusion) va confermata con
# lo smoke reale prima di attivarla. Vedi tech-debt/lead-engine/influencer-post-respondents.md
TAGGED_PERSON_ENABLED=false

# Percorso DB (default: data/sevedemo.db)
# DB_PATH=
