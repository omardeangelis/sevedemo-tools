# Copia questo file in `.env`. Solo i due token sono obbligatori: le altre righe sono commentate
# e valgono i default di `src/config.ts` (scommentale per cambiarli, poi riavvia `npm run ui`).

# --- Credenziali ---
# Apify: sync interazioni, sourcing da azienda, arricchimento. Senza, le anteprime mostrano un blocco.
APIFY_TOKEN=
# Anthropic: analisi AI dei prospect. Senza, l'analisi è bloccata.
ANTHROPIC_API_KEY=

# --- Analisi AI ---
# Modello usato per l'analisi.
# ANALYSIS_MODEL=claude-opus-5
# 1 = structured outputs; 0 = prompt "solo JSON" + validazione (modelli che non li supportano).
# ANALYSIS_STRUCTURED=1

# --- Sync interazioni dai miei post ---
# Post del mio profilo letti a ogni sync.
# POSTS_PER_SYNC=10
# I post più vecchi di N giorni non si risincronizzano (salvo "Risincronizza tutto").
# POST_RECENCY_DAYS=90
# Un post già sincronizzato si rilegge solo dopo N giorni (salvo "Risincronizza tutto").
# SYNC_COOLDOWN_DAYS=7
# Massimo di reazioni e di commenti (1-100) letti per post: limite di spesa.
# REACTIONS_PER_POST=300
# COMMENTS_PER_POST=100

# --- Sourcing da azienda ---
# Numero massimo di persone proposto nel dialog.
# EMPLOYEES_PER_COMPANY=50
# Modalità proposta: Short | Full | Full+email
# EMPLOYEES_MODE=Short

# --- Arricchimento ---
# Profili arricchiti in parallelo.
# ENRICH_CONCURRENCY=3
# Un arricchimento senza risultato si ritenta solo dopo N giorni.
# FRESHNESS_DAYS=90
# Prezzo in USD per profilo arricchito: vuoto = "stima non disponibile" nelle anteprime.
# PRICE_PROFILE_DETAIL_USD=
# Prezzo in USD di un'analisi AI per persona: assente = 0.03; vuoto = "stima non disponibile" (anteprime e scheda).
# PRICE_ANALYSIS_USD=0.03

# --- Apollo (aziende simili, contatti, email di lavoro) ---
# Facoltativo: senza chiave le funzioni Apollo mostrano un blocco, il resto del CRM funziona.
# Serve un piano a pagamento: master key, oppure chiave con il permesso di ricerca persone via API.
# APOLLO_API_KEY=
# Tetto di pagine di aziende lette per ricerca (1-100; il dialog ne propone 1).
# APOLLO_MAX_COMPANY_PAGES=3
# Persone proposte per azienda nella ricerca contatti (1-100).
# APOLLO_PEOPLE_PER_COMPANY=10
# Richieste al minuto verso Apollo per gli avvisi delle anteprime (minimo 1). Default 20: il limite più
# stretto visto sul piano (arricchimento e match 20/min, ricerche 50/min; anche tetti orari e giornalieri).
# APOLLO_RATE_LIMIT_PER_MINUTE=20
# Prezzo in USD di un credito Apollo: vuoto = "stima non disponibile" nelle anteprime.
# APOLLO_CREDIT_USD=

# --- Profilo e servizi (own-profile-services) ---
# Queste variabili NON sono ancora lette dal CRM: arrivano con le tappe successive (indicate a fianco).
# Cloudflare Browser Run, per leggere il tuo sito (M3): identificativo dell'account e token.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Tetto di pagine del tuo sito lette per generazione (M3).
# CLOUDFLARE_MAX_PAGES=10
# Modello della generazione di profilo e servizi (M4; default: il valore di ANALYSIS_MODEL).
# PROFILE_MODEL=
# Prezzo in USD di una generazione, per la stima (M4; vuoto = "stima non disponibile").
# PRICE_PROFILE_GENERATION_USD=

# --- Server locale ---
# Percorso del database SQLite (default: data/crm.db nella root del progetto).
# DB_PATH=/percorso/assoluto/crm.db
# Porta dell'API (default 8787). Se la cambi, avvia il frontend con API_URL=http://localhost:<porta>.
# UI_PORT=8787
