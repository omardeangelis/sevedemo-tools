{
  "name": "sevedemo-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tool di supporto alla piattaforma SeVedemo. Tool #1: Lead Engine (estrazione contatti LinkedIn via Apify + Claude).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "pipeline": "tsx src/cli.ts pipeline",
    "strategies": "tsx src/cli.ts strategies",
    "db:init": "tsx src/cli.ts db:init",
    "api": "tsx src/server/index.ts",
    "ui": "concurrently -n api,web -c blue,green \"npm run api\" \"npm --prefix web run dev\"",
    "ui:build": "npm --prefix web run build",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "tsc -p ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@hono/node-server": "^2.0.4",
    "apify-client": "^2.12.0",
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "hono": "^4.12.25",
    "p-limit": "^6.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
